{
  "name": "gods-rts",
  "version": "0.1.0",
  "private": true,
  "description": "Mythic RTS: command worshippers, raise cities, and summon gods, titans and mythical creatures. Browser game with online play.",
  "type": "module",
  "scripts": {
    "serve": "http-server . -p 8080 -c-1 --silent",
    "test": "node --test \"tests/**/*.test.js\"",
    "e2e": "node tests/e2e/run-all.mjs",
    "peer-server": "peerjs --port 9000 --path /myapp"
  },
  "devDependencies": {
    "http-server": "14.1.1",
    "peer": "1.0.2",
    "playwright": "1.56.1"
  }
}
